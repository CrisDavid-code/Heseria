# Configuración pública de Firebase (va dentro de cualquier app que use Firebase;
# lo que protege los datos son las reglas de firestore.rules).
# Sale de android/app/google-services.json, proyecto heseria-app.
VITE_FIREBASE_API_KEY=AIzaSyDh3_faB1hKUZi2DBGhMU6b4O9dRqxz9CM
VITE_FIREBASE_AUTH_DOMAIN=heseria-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=heseria-app
VITE_FIREBASE_STORAGE_BUCKET=heseria-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=943591056279
# PENDIENTE: reemplazar por el App ID de la app WEB (Firebase → Configuración del proyecto →
# Tus apps → Agregar app web). Mientras tanto se usa el de Android, que basta para Auth y Firestore.
VITE_FIREBASE_APP_ID=1:943591056279:android:84b3259e327adaac6edad2
VITE_GOOGLE_WEB_CLIENT_ID=943591056279-m9qlhfh1p9h8na944k70o3l51n0n8s83.apps.googleusercontent.com
# Id de la base de datos de Firestore (modo nativo). Vacío = «(default)».
VITE_FIREBASE_DATABASE=(default)
