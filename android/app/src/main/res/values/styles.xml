<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/heseriaPrimary</item>
        <item name="colorPrimaryDark">@color/heseriaPrimaryDark</item>
        <item name="colorAccent">@color/heseriaPrimary</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
      Pantalla de apertura.

      Android 12 y posteriores ignoran una imagen a pantalla completa: muestran
      un icono centrado sobre un color, que es justo el comportamiento de
      Spotify o WhatsApp. Se declaran las dos cosas para que también se vea bien
      en versiones anteriores, donde manda `windowBackground`.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/heseriaBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
